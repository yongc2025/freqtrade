{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "max_open_trades": 5,
    "stake_currency": "USDT",
    "stake_amount": "unlimited",
    "tradable_balance_ratio": 0.75,
    "fiat_display_currency": "USD",

    "dry_run": true,
    "dry_run_wallet": 10000,

    "timeframe": "1h",

    "trailing_stop": true,
    "trailing_stop_positive": 0.12,
    "trailing_stop_positive_offset": 0.20,
    "trailing_only_offset_is_reached": true,

    "stoploss": -0.08,

    "minimal_roi": {
        "0": 100
    },

    "unfilledtimeout": {
        "entry": 10,
        "exit": 10,
        "unit": "minutes"
    },

    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    },

    "exit_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    },

    "exchange": {
        "name": "binance",
        "key": "",
        "secret": "",
        "pair_whitelist": [],
        "pairlist": [
            {
                "method": "GMGNPairList",
                "number_assets": 20,
                "chain": "sol",
                "trending_limit": 30,
                "smartmoney_limit": 20,
                "max_workers": 10,
                "max_rug_ratio": 0.3,
                "max_bundler_rate": 0.2,
                "max_rat_trader_rate": 0.15,
                "min_liquidity": 50000,
                "refresh_period": 3600
            }
        ]
    },

    "strategy": "AltcoinCompressionStrategy",
    "user_data_dir": "user_data"
}
