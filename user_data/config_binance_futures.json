{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "strategy": "BinanceFuturesCompressionStrategy",
  "user_data_dir": "user_data",
  "max_open_trades": 10,
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.75,
  "fiat_display_currency": "",
  "dry_run": true,
  "dry_run_wallet": 10000,
  "timeframe": "1h",
  "bot_name": "BinanceFutures-Compression-DryRun",
  "initial_state": "running",
  "force_entry_enable": false,
  "trailing_stop": true,
  "trailing_stop_positive": 0.05,
  "trailing_stop_positive_offset": 0.08,
  "trailing_only_offset_is_reached": true,
  "stoploss": -0.03,
  "minimal_roi": {
    "0": 100
  },
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "leverage": 3,
  "liquidation_buffer": 0.05,
  "fee": 0.0005,
  "order_types": {
    "entry": "limit",
    "exit": "limit",
    "time_in_force": "ioc",
    "stoploss": "market",
    "stoploss_on_exchange": true
  },
  "entry_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": true,
    "order_book_top": 1
  },
  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "exit_timeout_count": 0
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "type": "futures",
    "ccxt_config": {
      "timeout": 30000,
      "proxies": {
        "http": "http://127.0.0.1:10808",
        "https": "http://127.0.0.1:10808"
      },
      "options": {
        "defaultType": "future"
      }
    },
    "ccxt_async_config": {
      "timeout": 30000,
      "aiohttp_trust_env": false,
      "aiohttp_proxy": "http://127.0.0.1:10808",
      "options": {
        "defaultType": "future"
      }
    },
    "pair_whitelist": [
      "BTC/USDT:USDT",
      "ETH/USDT:USDT",
      "SOL/USDT:USDT",
      "XRP/USDT:USDT",
      "BNB/USDT:USDT",
      "TRX/USDT:USDT",
      "ADA/USDT:USDT",
      "DOGE/USDT:USDT",
      "AVAX/USDT:USDT",
      "TON/USDT:USDT",
      "SUI/USDT:USDT",
      "LINK/USDT:USDT",
      "DOT/USDT:USDT",
      "MATIC/USDT:USDT",
      "UNI/USDT:USDT",
      "LTC/USDT:USDT",
      "BCH/USDT:USDT",
      "ATOM/USDT:USDT",
      "XLM/USDT:USDT",
      "ETC/USDT:USDT",
      "FIL/USDT:USDT"
    ],
    "pair_blacklist": [
      ".*BEAR/.*",
      ".*BULL/.*",
      ".*UP/.*",
      ".*DOWN/.*",
      ".*HEDGE/.*",
      "XAU/USDT:USDT",
      "XAG/USDT:USDT",
      "CL/USDT:USDT",
      "BZ/USDT:USDT",
      "NG/USDT:USDT",
      "ES/USDT:USDT",
      "NQ/USDT:USDT",
      "YM/USDT:USDT",
      "RTY/USDT:USDT",
      "NKD/USDT:USDT",
      "INTC/USDT:USDT",
      "EWY/USDT:USDT",
      "EWJ/USDT:USDT",
      "EWW/USDT:USDT",
      "EWZ/USDT:USDT",
      "FXI/USDT:USDT",
      "BABA/USDT:USDT",
      "TSM/USDT:USDT",
      "NVDA/USDT:USDT",
      "AAPL/USDT:USDT",
      "TSLA/USDT:USDT",
      "GOOGL/USDT:USDT",
      "AMZN/USDT:USDT",
      "META/USDT:USDT",
      "MSFT/USDT:USDT",
      "COIN/USDT:USDT",
      "MSTR/USDT:USDT"
    ]
  },
  "api_server": {
    "enabled": true,
    "listen_ip_address": "0.0.0.0",
    "listen_port": 8082,
    "verbosity": "error",
    "enable_openapi": false,
    "jwt_secret_key": "bf_compression_local_key",
    "CORS_origins": ["http://localhost:8082", "http://127.0.0.1:8082"],
    "username": "admin",
    "password": "your_password_here"
  },
  "db_url": "sqlite:///user_data/tradesv3_binance_futures.sqlite?check_same_thread=False",
  "logfile": "user_data/logs/freqtrade_binance_futures.log",
  "internals": {
    "process_throttle_secs": 5
  }
}
