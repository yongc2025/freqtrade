{
    "$schema": "https://schema.freqtrade.io/schema.json",

    "strategy": "AltcoinCompressionStrategy",
    "user_data_dir": "user_data",

    "max_open_trades": 5,
    "stake_currency": "USDT",
    "stake_amount": "unlimited",
    "tradable_balance_ratio": 0.75,
    "fiat_display_currency": "USD",

    "dry_run": true,
    "dry_run_wallet": 10000,

    "timeframe": "1h",
    "bot_name": "GMGN-Altcoin-DryRun",
    "initial_state": "running",
    "force_entry_enable": false,

    "trailing_stop": true,
    "trailing_stop_positive": 0.12,
    "trailing_stop_positive_offset": 0.20,
    "trailing_only_offset_is_reached": true,
    "stoploss": -0.08,

    "minimal_roi": {
        "0": 100
    },

    "trading_mode": "futures",
    "margin_mode": "isolated",
    "leverage": 1,
    "liquidation_buffer": 0.05,
    "fee": 0.0005,

    "order_types": {
        "entry": "limit",
        "exit": "limit",
        "time_in_force": "ioc",
        "stoploss": "market",
        "stoploss_on_exchange": true
    },

    "entry_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },

    "exit_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },

    "unfilledtimeout": {
        "entry": 10,
        "exit": 10,
        "exit_timeout_count": 0
    },

    "pairlists": [
        {
            "method": "GMGNPairList",
            "number_assets": 20,
            "chain": "sol",
            "trending_limit": 30,
            "smartmoney_limit": 20,
            "max_workers": 10,
            "max_rug_ratio": 0.3,
            "max_bundler_rate": 0.2,
            "max_rat_trader_rate": 0.15,
            "min_liquidity": 50000,
            "refresh_period": 3600,
            "gmgn_cli": "C:\\Users\\yongc\\AppData\\Roaming\\npm\\gmgn-cli.cmd"
        }
    ],

    "exchange": {
        "name": "binance",
        "key": "",
        "secret": "",
        "type": "futures",
        "ccxt_config": {
            "timeout": 30000,
            "proxies": {
                "http": "http://127.0.0.1:10808",
                "https": "http://127.0.0.1:10808"
            },
            "options": {
                "defaultType": "future"
            }
        },
        "ccxt_async_config": {
            "timeout": 30000,
            "aiohttp_trust_env": false,
            "aiohttp_proxy": "http://127.0.0.1:10808",
            "options": {
                "defaultType": "future"
            }
        },
        "pair_whitelist": [],
        "pair_blacklist": [
            "(BSC)/.*",
            ".*REWARD/.*",
            ".*BEAR/.*",
            ".*BULL/.*",
            ".*UP/.*",
            ".*DOWN/.*",
            ".*BNB/.*",
            "BTC/USDT:USDT",
            "ETH/USDT:USDT",
            "SOL/USDT:USDT",
            "XRP/USDT:USDT",
            "BNB/USDT:USDT",
            "TRX/USDT:USDT",
            "ADA/USDT:USDT",
            "DOGE/USDT:USDT"
        ]
    },

    "db_url": "sqlite:///user_data/tradesv3_gmgn_dryrun.sqlite?check_same_thread=False",
    "logfile": "user_data/logs/freqtrade_gmgn_dryrun.log",

    "internals": {
        "process_throttle_secs": 5
    }
}
