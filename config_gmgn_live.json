{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "max_open_trades": 10,
    "stake_currency": "USDT",
    "stake_amount": "unlimited",
    "tradable_balance_ratio": 0.95,
    "fiat_display_currency": "USD",

    "dry_run": true,
    "dry_run_wallet": 10000,

    "timeframe": "1h",
    "bot_name": "AltcoinCompression_GMGN",
    "initial_state": "running",
    "force_entry_enable": false,

    "exchange": {
        "name": "binance",
        "key": "",
        "secret": "",
        "type": "futures",
        "ccxt_config": {
            "timeout": 30000,
            "options": {
                "defaultType": "future"
            }
        },
        "ccxt_async_config": {
            "timeout": 30000,
            "aiohttp_trust_env": false,
            "options": {
                "defaultType": "future"
            }
        },
        "pair_whitelist": [],
        "pair_blacklist": [
            "(BSC)/.*",
            ".*REWARD/.*",
            ".*BEAR/.*",
            ".*BULL/.*",
            ".*UP/.*",
            ".*DOWN/.*",
            ".*BNB/.*",
            "BTC/USDT:USDT",
            "ETH/USDT:USDT",
            "SOL/USDT:USDT",
            "XRP/USDT:USDT",
            "BNB/USDT:USDT",
            "TRX/USDT:USDT",
            "ADA/USDT:USDT",
            "DOGE/USDT:USDT"
        ],
        "pairlist": [
            {
                "method": "GMGNPairList",
                "number_assets": 20,
                "chain": "sol",
                "trending_limit": 30,
                "smartmoney_limit": 20,
                "max_workers": 10,
                "max_rug_ratio": 0.3,
                "max_bundler_rate": 0.2,
                "max_rat_trader_rate": 0.15,
                "min_liquidity": 50000,
                "refresh_period": 3600,
                "address_cache_path": "user_data/gmgn_address_cache.json",
                "security_cache_path": "user_data/gmgn_security_cache.json"
            }
        ]
    },

    "strategy": "AltcoinCompressionStrategy",

    "trailing_stop": true,
    "trailing_stop_positive": 0.12,
    "trailing_stop_positive_offset": 0.20,
    "trailing_only_offset_is_reached": true,

    "stoploss": -0.08,

    "minimal_roi": {
        "0": 100
    },

    "trading_mode": "futures",
    "margin_mode": "isolated",
    "leverage": 1,
    "liquidation_buffer": 0.05,

    "order_types": {
        "entry": "limit",
        "exit": "limit",
        "time_in_force": "ioc",
        "stoploss": "market",
        "stoploss_on_exchange": true
    },

    "entry_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },

    "exit_pricing": {
        "price_side": "other",
        "use_order_book": true,
        "order_book_top": 1
    },

    "unfilledtimeout": {
        "entry": 10,
        "exit": 10,
        "exit_timeout_count": 0
    },

    "api_server": {
        "enabled": true,
        "listen_ip_address": "0.0.0.0",
        "listen_port": 8781,
        "verbosity": "error",
        "enable_openapi": false,
        "jwt_secret_key": "change_this_to_a_random_secret",
        "CORS_origins": ["http://localhost:8781", "http://127.0.0.1:8781"],
        "username": "admin",
        "password": "INSERT_YOUR_COMPLEX_PASSWORD_HERE"
    },

    "db_url": "sqlite:///user_data/tradesv3_gmgn_live.sqlite?check_same_thread=False",
    "logfile": "user_data/logs/freqtrade_gmgn_live.log",

    "internals": {
        "process_throttle_secs": 15
    }
}
